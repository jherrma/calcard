#!/usr/bin/env python3
"""CalCard end-to-end suite — black-box tests against a deployed server.

  ./run                     run every suite
  ./run dav_caldav auth     run the named suites (in the given order)
  ./run --list              list the suites
  ./run -v | -vv            log every request (-vv: and bodies)
  ./run -- -k etag -x       anything after -- goes to pytest unchanged

Configuration: e2e/.env (copy .env.example) — environment variables win.
See e2e/README.md.
"""

from __future__ import annotations

import ast
import os
import re
import sys
from pathlib import Path

E2E_DIR = Path(__file__).resolve().parent

USAGE = """\
Usage: ./run [options] [suite...] [-- pytest-args...]

Options:
  --list            list available suites and exit
  -v, -vv           verbose: log each request (-vv also logs bodies)
  --strict          count known server bugs (KFAIL) as failures
  --keep-data       do not delete the test users / data at the end (debugging)
  --results FILE    also write one "OUTCOME<TAB>suite/test" line per test to FILE
  -h, --help        this help

Suites run in the order given (default: all, in file order). Suite selection
can also come from E2E_SUITES / E2E_SKIP_SUITES (space or comma separated).
Exit code: 0 all good, 1 a test failed (or a known bug no longer reproduces),
2 the run could not start, 130 interrupted.
"""


def suites() -> list[tuple[str, str]]:
    found = []
    for p in sorted((E2E_DIR / "tests").glob("test_[0-9][0-9]_*.py")):
        name = re.match(r"test_\d\d_(.+)\.py$", p.name).group(1)
        desc = ""
        for node in ast.parse(p.read_text(encoding="utf-8")).body:
            if isinstance(node, ast.Assign) and any(getattr(t, "id", "") == "DESCRIPTION" for t in node.targets):
                desc = node.value.value
        found.append((name, desc))
    return found


def die(msg: str) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(2)


def main(argv: list[str]) -> int:
    passthrough: list[str] = []
    if "--" in argv:
        i = argv.index("--")
        argv, passthrough = argv[:i], argv[i + 1:]
    selected: list[str] = []
    args = iter(argv)
    for a in args:
        if a == "--list":
            print("Available suites:")
            for name, desc in suites():
                print(f"  {name:<16} {desc}")
            return 0
        if a in ("-h", "--help"):
            print(USAGE, end="")
            return 0
        if a == "-v":
            os.environ["E2E_VERBOSE"] = "1"
        elif a == "-vv":
            os.environ["E2E_VERBOSE"] = "2"
        elif a == "--strict":
            os.environ["E2E_STRICT"] = "true"
        elif a == "--keep-data":
            os.environ["E2E_KEEP_DATA"] = "true"
        elif a == "--results":
            os.environ["E2E_RESULTS_FILE"] = str(Path(next(args, "") or die("--results needs a file")).resolve())
        elif a.startswith("-"):
            print(USAGE, end="", file=sys.stderr)
            die(f"unknown option {a}")
        else:
            selected += [s for s in re.split(r"[\s,]+", a) if s]

    names = [n for n, _ in suites()]
    for s in selected:
        if s not in names:
            die(f"unknown suite '{s}' — available: {' '.join(names)}")
    if selected:
        # Command-line suites override E2E_SUITES from the environment or .env.
        os.environ["E2E_SUITES"] = " ".join(selected)

    try:
        import httpx  # noqa: F401
        import lxml  # noqa: F401
        import pytest
    except ImportError as e:
        die(f"missing Python package ({e.name}). Install the suite's requirements, e.g.\n"
            f"       python3 -m venv .venv && .venv/bin/pip install -r requirements.txt && .venv/bin/python run\n"
            f"       or: uv run --with-requirements requirements.txt ./run")
    os.chdir(E2E_DIR)
    rc = int(pytest.main(passthrough))
    # pytest's internal/usage errors mean the run could not start.
    return rc if rc in (0, 1, 2, 130) else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
