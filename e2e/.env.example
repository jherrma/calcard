# CalCard e2e suite configuration. Copy to e2e/.env and adjust.
# Variables already set in the shell environment always win over this file,
# e.g.  CALCARD_URL=https://cal.example.com ./run dav_caldav
#
# Syntax: KEY=VALUE per line, optional quotes, '#' comments. Parsed, not
# executed — no command substitution, no variable expansion.

# --- Target (required: CALCARD_URL, or CALCARD_HOST [+ PORT/SCHEME]) --------
# Full base URL of the deployed server: scheme, host or IP, optional port.
CALCARD_URL=http://127.0.0.1:8080
# Alternative to CALCARD_URL: host/IP (may include :port or be a full URL),
# plus optional port and scheme (scheme defaults to https for port 443, else http).
#CALCARD_HOST=192.168.1.10
#CALCARD_PORT=8080
#CALCARD_SCHEME=http

# Accept self-signed / untrusted TLS certificates.
E2E_INSECURE=false

# --- Timeouts ------------------------------------------------------------------
# Per-request timeout and connect timeout (seconds).
E2E_TIMEOUT=30
E2E_CONNECT_TIMEOUT=10
# How long to wait for GET /health to answer 200 before giving up (seconds).
E2E_HEALTH_WAIT=60

# --- Test users ------------------------------------------------------------------
# Every run registers fresh users named <prefix>-<run id>-<key>@<domain>
# (lowercase letters, digits, '-'). Change the prefix to tell runs of
# different people/pipelines apart.
E2E_USER_PREFIX=e2e
E2E_EMAIL_DOMAIN=example.test
# Password for the test users; empty = a random one per run (recommended).
E2E_PASSWORD=

# --- Selection & output ------------------------------------------------------------
# Suites to run (space or comma separated; empty = all — see ./run --list).
# Arguments of ./run override this.
E2E_SUITES=
# Suites to leave out.
E2E_SKIP_SUITES=
# 0 = results only, 1 = log every request, 2 = also log bodies.
E2E_VERBOSE=0
# Characters of a response body printed for a failing assertion.
E2E_BODY_PREVIEW=1200
# Count known server bugs (KFAIL, see FINDINGS.md) as failures.
E2E_STRICT=false
# Also write one "OUTCOME<TAB>suite/test" line per test to this file (./run --results).
#E2E_RESULTS_FILE=
# Keep the test users and their data on the server (debugging only).
E2E_KEEP_DATA=false
# Colours are off when NO_COLOR is set or stdout is not a terminal.
#NO_COLOR=1

# --- Rate limiting ---------------------------------------------------------------------
# On HTTP 429 the suite waits Retry-After (capped) and retries the request.
E2E_RATE_LIMIT_RETRIES=6
E2E_RATE_LIMIT_MAX_WAIT=90
# Opt-in: trip the per-account login limiter with ~11 failed logins for a
# throwaway address (also spends part of this IP's login allowance for a window).
E2E_RATE_LIMIT_BURST=false

# --- Subscription feed server ------------------------------------------------------------
# The subscription tests serve an .ics feed from this machine (a small HTTP
# server inside the test process); the CalCard server must be able to reach it.
# auto = run it; off = skip the fetch tests.
E2E_FEED=auto
# Address of THIS machine as seen from the server (default: 127.0.0.1 for a
# local target, otherwise the source address of the route to the target).
# For a server in Docker on this host use e.g. host.docker.internal or the
# bridge IP (172.17.0.1).
E2E_FEED_HOST=
# Interface the feed server binds to (default: 127.0.0.1 locally, else 0.0.0.0).
E2E_FEED_BIND=
# Fixed port for the feed server (default: random).
E2E_FEED_PORT=
