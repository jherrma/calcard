server:
  host: 0.0.0.0
  port: 8080

base_url: https://caldav.example.com

# Database configuration
# Omit this section entirely to use SQLite (default).
# NOTE: ${VAR} placeholders are NOT expanded by the config loader. Values here
# are literal samples; set the corresponding CALDAV_* environment variables to
# override any field (env vars always win over this file).
database:
  host: postgres
  port: 5432
  user: caldav
  password: change-me  # override via CALDAV_DB_PASSWORD
  name: caldav
  ssl_mode: require

jwt:
  # Leave unset to auto-generate and persist a secret on first boot, or set
  # CALDAV_JWT_SECRET (min 16 chars). A value placed here is used verbatim.
  secret: ""
  access_expiry: 15m
  refresh_expiry: 168h  # 7 days

# OAuth/OIDC providers. ${VAR} is NOT expanded here; either fill in literal
# values or (recommended) set the CALDAV_OAUTH_* environment variables, which
# override these fields.
#
# The redirect URI to register at your OAuth provider is:
#   {base_url}/api/v1/auth/oauth/{google|microsoft|custom}/callback
# base_url (CALDAV_BASE_URL) must therefore be the public URL of this server.
oauth:
  google:
    client_id: ""      # or CALDAV_OAUTH_GOOGLE_CLIENT_ID
    client_secret: ""  # or CALDAV_OAUTH_GOOGLE_CLIENT_SECRET

  microsoft:
    client_id: ""      # or CALDAV_OAUTH_MICROSOFT_CLIENT_ID
    client_secret: ""  # or CALDAV_OAUTH_MICROSOFT_CLIENT_SECRET
    # Default issuer is the multi-tenant endpoint
    # (https://login.microsoftonline.com/common/v2.0), which accepts any
    # Microsoft account. For a single-tenant app registration, set your
    # tenant-specific issuer instead:
    # issuer: "https://login.microsoftonline.com/<tenant-id>/v2.0"
    #
    # Microsoft's userinfo endpoint never returns email_verified, so new-user
    # sign-in and auto-linking via Microsoft require this opt-in. Only enable
    # it for a provider you trust to return addresses its users control:
    assume_email_verified: true   # or CALDAV_OAUTH_MICROSOFT_ASSUME_EMAIL_VERIFIED

  # Custom OIDC Provider (e.g. Keycloak, Auth0)
  custom:
    client_id: ""      # or CALDAV_OAUTH_CUSTOM_CLIENT_ID
    client_secret: ""  # or CALDAV_OAUTH_CUSTOM_CLIENT_SECRET
    issuer: ""         # or CALDAV_OAUTH_CUSTOM_ISSUER

logging:
  level: info
  format: json  # or "text"

security:
  enabled: true
  hsts_enabled: true
  hsts_max_age: 31536000

