# Build context is the repo root (see server/Dockerfile). Keep it small: the web
# stage runs a clean `pnpm install`, so node_modules/.nuxt/.output must not be
# uploaded (~hundreds of MB), and the server never needs git/data/docs here.
.git
.gitignore
webinterface/node_modules
webinterface/.nuxt
webinterface/.output
webinterface/dist
server/data
server/bin
server/tmp
# Local env files are gitignored but exist on dev machines. webinterface/.env sets
# NUXT_PUBLIC_API_BASE_URL=http://localhost:8080, and Nuxt would bake it into the
# SPA, pointing every browser at its OWN localhost instead of the server.
**/.env
**/.env.*
!**/.env.example
**/*.log
*.md
stories/
